// Thông tin phiên bản và biểu tượng cho QLTTTA.exe (Windows)
#include <winver.h>

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "042a04b0"
        BEGIN
            VALUE "CompanyName", "UIT - IE103 Nhom 1"
            VALUE "FileDescription", "QLTTTA - Quan ly Trung tam Tieng Anh"
            VALUE "ProductName", "QLTTTA"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "QLTTTA.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x42a, 1200
    END
END
