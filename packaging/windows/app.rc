// Version information and icon of QLTTTA.exe (Windows)
#include <winver.h>

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UIT - IE103 Group 1"
            VALUE "FileDescription", "QLTTTA - English Center Management"
            VALUE "ProductName", "QLTTTA"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "QLTTTA.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
