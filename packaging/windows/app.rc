// Version information and icon of QLTTTA.exe (Windows), shown in Explorer > Properties > Details.
// The QLTTTA_VERSION_* numbers are defined by src/app/CMakeLists.txt from project(VERSION ...) in CMakeLists.txt.
#include <winver.h>

#define QLTTTA_STR_(x) #x
#define QLTTTA_STR(x) QLTTTA_STR_(x)

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION QLTTTA_VERSION_MAJOR,QLTTTA_VERSION_MINOR,QLTTTA_VERSION_PATCH,0
PRODUCTVERSION QLTTTA_VERSION_MAJOR,QLTTTA_VERSION_MINOR,QLTTTA_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UIT - IE103 Group 1"
            VALUE "FileDescription", "QLTTTA - English Center Management"
            VALUE "FileVersion", QLTTTA_STR(QLTTTA_VERSION_TEXT)
            VALUE "ProductName", "QLTTTA"
            VALUE "ProductVersion", QLTTTA_STR(QLTTTA_VERSION_TEXT)
            VALUE "OriginalFilename", "QLTTTA.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
