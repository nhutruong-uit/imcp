# ---- Build output: every CMake preset builds into build/<preset>, installers go to dist/ ----
build/
dist/
CMakeUserPresets.json
# Symlink to build/<preset>/compile_commands.json (CMakeLists.txt) and the clangd background index
compile_commands.json
.cache/

# ---- IDE ----
# VS Code / Cursor: only the shared settings and the recommended extensions are committed
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# Qt Creator
*.user
*.user.*
*.autosave
.qtcreator/
# Visual Studio, CLion
.vs/
.idea/
cmake-build-*/

# ---- Claude Code: .claude/settings.json is shared ----
.claude/settings.local.json
.claude/worktrees/
# Personal instructions; while this file exists Claude Code reads it instead of AGENTS.md
CLAUDE.local.md

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets ----
.env

# ---- Python (report tooling, clang-format from pip) ----
.venv/
__pycache__/

# ---- Report ----
# Word lock files (~$name.docx) while a document is open
~$*
docs/report/.build/
# Real student IDs and the copies for the lecturer built with them (build_report.py --submission): the repository
# may be public, so only the masked IDs are committed
docs/report/student_ids.local.json
*_submission.docx
*_submission.pdf
