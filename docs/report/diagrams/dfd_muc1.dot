// DFD mức 1
digraph DFD1 {
  graph [rankdir=LR, fontname="Arial", dpi=220, pad=0.2, nodesep=0.35, ranksep=0.9];
  node  [fontname="Arial", fontsize=11];
  edge  [fontname="Arial", fontsize=9, color="#334155"];
  node [shape=box, style=filled, fillcolor="#F1F5F9", color="#334155"];
  HV [label="Học viên"]; GV [label="Giáo viên"]; NV [label="Giáo vụ"]; KTO [label="Kế toán"];
  node [shape=circle, style=filled, fillcolor="#DBEAFE", color="#1F3864", width=1.3, fixedsize=true, fontsize=10];
  P1 [label="1.0\nTuyển sinh &\nkiểm tra\nđầu vào"]; P2 [label="2.0\nQuản lý lớp\n& lịch học"]; P3 [label="3.0\nGhi danh"];
  P4 [label="4.0\nThu học phí"]; P5 [label="5.0\nĐiểm danh\n& điểm"]; P6 [label="6.0\nXét kết quả\n& lương"];
  node [shape=record, style=filled, fillcolor="#FEF3C7", color="#B45309", fixedsize=false, width=1.8, fontsize=10];
  D1 [label="D1 | HOCVIEN, KIEMTRADAUVAO"]; D2 [label="D2 | KHOAHOC, LOPHOC, LICHHOC, BUOIHOC"]; D3 [label="D3 | GHIDANH, KHUYENMAI"];
  D4 [label="D4 | PHIEUTHU"]; D5 [label="D5 | DIEMDANH, DIEM"]; D6 [label="D6 | CHUNGCHI, BANGLUONG"];
  HV -> P1 [label="hồ sơ, bài KT"]; P1 -> D1; NV -> P2 [label="kế hoạch mở lớp"]; P2 -> D2;
  HV -> P3 [label="yêu cầu ghi danh"]; D1 -> P3 [label="điều kiện đầu vào"]; D2 -> P3 [label="sĩ số, lịch"]; P3 -> D3;
  HV -> P4 [label="tiền học phí"]; D3 -> P4 [label="còn nợ"]; P4 -> D4; P4 -> HV [label="biên lai"]; KTO -> P4;
  GV -> P5 [label="điểm danh, điểm"]; D2 -> P5; P5 -> D5;
  D5 -> P6; D3 -> P6; P6 -> D6; P6 -> HV [label="chứng nhận"]; P6 -> GV [label="bảng lương"];
}
