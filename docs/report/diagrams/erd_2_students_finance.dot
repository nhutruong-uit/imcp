// ERD (ký hiệu Chen) - Phân hệ học viên, ghi danh, tài chính, kết quả học tập
// Bố cục lưới cố định (pos="x,y!" tính bằng inch) và đường vuông góc (splines=ortho), như ERD 1: ENROLLMENT ở
// giữa; bên trái là học viên, phía trên là lớp và người ghi danh, bên phải là tài chính, phía dưới là kết quả học tập.
graph ERD2 {
  graph [layout=neato, splines=ortho, fontname="Arial", pad=0.3, dpi=220, outputorder=edgesfirst];
  node  [fontname="Arial", fontsize=13, pin=true];
  edge  [fontname="Arial", fontsize=12, color="#334155", penwidth=1.3, labelfontcolor="#B91C1C", labelfontsize=12,
         labeldistance=2.1, labelangle=28];

  node [shape=box, style="filled,rounded", fillcolor="#DBEAFE", color="#1F3864", penwidth=1.4, margin="0.12,0.06"];
  BRANCH [pos="0,7.8!", label=<<B>BRANCH</B><BR/><U>BranchId</U>, ...>, fillcolor="#F1F5F9"];
  STUDENT [pos="0,5.2!", label=<<B>STUDENT</B><BR/><U>StudentId</U>, FullName, DateOfBirth, Phone,<BR/>GuardianName, GuardianPhone, Status>];
  PLACEMENT_TEST [pos="0,2.6!", label=<<B>PLACEMENT_TEST</B><BR/><U>TestId</U>, ListeningScore, SpeakingScore,<BR/>ReadingScore, WritingScore, /OverallScore>];
  COURSE [pos="0,0!", label=<<B>COURSE</B><BR/><U>CourseId</U>, ...>, fillcolor="#F1F5F9"];
  CLASS [pos="7.6,7.8!", label=<<B>CLASS</B><BR/><U>ClassId</U>, ...>, fillcolor="#F1F5F9"];
  ENROLLMENT [pos="7.6,5.2!", label=<<B>ENROLLMENT</B> (thực thể kết hợp)<BR/><U>EnrollmentId</U>, EnrolledOn, BaseTuition,<BR/>DiscountAmount, /TuitionDue, /AmountPaid, Result>, fillcolor="#E0E7FF"];
  CLASS_SESSION [pos="4.0,0!", label=<<B>CLASS_SESSION</B><BR/><U>SessionId</U>, ...>, fillcolor="#F1F5F9"];
  CERTIFICATE [pos="7.6,0!", label=<<B>CERTIFICATE</B><BR/><U>CertificateId</U>, SerialNumber,<BR/>IssuedOn, Classification>];
  GRADE_COMPONENT [pos="11.2,0!", label=<<B>GRADE_COMPONENT</B><BR/><U>ComponentId</U>, ...>, fillcolor="#F1F5F9"];
  EMPLOYEE [pos="15.6,7.8!", label=<<B>EMPLOYEE</B><BR/><U>EmployeeId</U>, ...>, fillcolor="#F1F5F9"];
  RECEIPT [pos="15.6,5.2!", label=<<B>RECEIPT</B><BR/><U>ReceiptId</U>, PaidAtUtc, Amount,<BR/>PaymentMethod, Status>];
  PROMOTION [pos="15.6,2.6!", label=<<B>PROMOTION</B><BR/><U>PromotionId</U>, DiscountType, DiscountValue,<BR/>StartDate, EndDate>];
  AUDIT_LOG [pos="15.6,0!", label=<<B>AUDIT_LOG</B> (nhật ký, ghi bởi trigger)<BR/><U>LogId</U>, TableName, Action,<BR/>OldData (XML), NewData (XML)>, fillcolor="#FCE7F3"];

  node [shape=diamond, style=filled, fillcolor="#FEF3C7", color="#B45309", penwidth=1.2, fontsize=10, width=1.15, height=0.62, margin=0];
  r_tn [pos="0,6.5!", label="tiếp\nnhận"];
  r_lam [pos="0,3.9!", label="làm\nbài"];
  r_dx [pos="0,1.3!", label="đề\nxuất"];
  r_dk [pos="3.8,5.2!", label="đăng\nký"];
  r_co [pos="7.6,6.5!", label="có học\nviên"];
  r_nv [pos="11.6,7.8!", label="ghi\ndanh bởi"];
  r_dong [pos="11.6,5.2!", label="đóng\ntiền"];
  r_lap [pos="15.6,6.5!", label="lập\nphiếu"];
  r_km [pos="12.4,2.6!", label="áp\ndụng"];
  ATTENDANCE [pos="5.8,2.6!", label="ATTENDANCE\n(Status)", width=1.5, height=0.75];
  r_cap [pos="7.6,2.6!", label="được\ncấp"];
  GRADE [pos="9.4,2.6!", label="GRADE\n(Score)", width=1.3, height=0.7];

  STUDENT -- r_tn [taillabel="(1,1)"]; r_tn -- BRANCH [headlabel="(0,n)"];
  STUDENT -- r_lam [taillabel="(0,n)"]; r_lam -- PLACEMENT_TEST [headlabel="(1,1)"];
  PLACEMENT_TEST -- r_dx [taillabel="(0,1)"]; r_dx -- COURSE [headlabel="(0,n)"];
  STUDENT -- r_dk [taillabel="(0,n)"]; r_dk -- ENROLLMENT [headlabel="(1,1)"];
  CLASS -- r_co [taillabel="(0,n)"]; r_co -- ENROLLMENT [headlabel="(1,1)"];
  ENROLLMENT -- r_nv [taillabel="(0,1)"]; r_nv -- EMPLOYEE [headlabel="(0,n)"];
  ENROLLMENT -- r_dong [taillabel="(0,n)"]; r_dong -- RECEIPT [headlabel="(1,1)"];
  RECEIPT -- r_lap [taillabel="(1,1)"]; r_lap -- EMPLOYEE [headlabel="(0,n)"];
  ENROLLMENT -- r_km [taillabel="(0,1)", labelangle=-35]; r_km -- PROMOTION [headlabel="(0,n)"];
  ENROLLMENT -- ATTENDANCE [taillabel="(0,n)"]; ATTENDANCE -- CLASS_SESSION [headlabel="(0,n)"];
  ENROLLMENT -- r_cap [taillabel="(0,1)"]; r_cap -- CERTIFICATE [headlabel="(1,1)"];
  ENROLLMENT -- GRADE [taillabel="(0,n)"]; GRADE -- GRADE_COMPONENT [headlabel="(0,n)"];
}
