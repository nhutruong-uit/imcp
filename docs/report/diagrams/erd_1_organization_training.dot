// ERD (ký hiệu Chen) - Phân hệ tổ chức, nhân sự, đào tạo, lớp học
// Bố cục lưới cố định (pos="x,y!" tính bằng inch) và đường vuông góc (splines=ortho): mỗi mối kết hợp nằm
// giữa hai thực thể của nó nên không có đường cắt nhau. Sơ đồ thu gọn còn khoảng 13,5 x 7,5 inch (thuộc tính bó
// thành 2-3 dòng ngắn) để chữ vẫn đọc được khi in trên một trang ngang. Thêm thực thể: chọn một ô trống của lưới.
graph ERD1 {
  graph [layout=neato, splines=ortho, fontname="Arial", pad=0.25, dpi=220, outputorder=edgesfirst];
  node  [fontname="Arial", fontsize=12, pin=true];
  edge  [fontname="Arial", fontsize=10.5, color="#334155", penwidth=1.3, labelfontcolor="#B91C1C", labelfontsize=10.5,
         labeldistance=1.9, labelangle=28];

  node [shape=box, style="filled,rounded", fillcolor="#DBEAFE", color="#1F3864", penwidth=1.4, margin="0.1,0.05"];
  PAYROLL [pos="3.5,6.3!", label=<<B>PAYROLL</B><BR/><U>PayrollId</U>, Month, Year,<BR/>Hours, TotalPay>];
  ACCOUNT [pos="0,4.2!", label=<<B>ACCOUNT</B><BR/><U>Username</U>, Role>];
  TEACHER [pos="3.5,4.2!", label=<<B>TEACHER</B><BR/><U>TeacherId</U>, FullName,<BR/>TeacherType, HourlyRate,<BR/>ProfileXml>];
  CLASS_SESSION [pos="7,4.2!", label=<<B>CLASS_SESSION</B><BR/><U>SessionId</U>, SessionNo,<BR/>SessionDate, Status>];
  PROGRAM [pos="10.5,4.2!", label=<<B>PROGRAM</B><BR/><U>ProgramId</U>, ProgramName>];
  EMPLOYEE [pos="0,2.1!", label=<<B>EMPLOYEE</B><BR/><U>EmployeeId</U>, FullName,<BR/>Position>];
  BRANCH [pos="3.5,2.1!", label=<<B>BRANCH</B><BR/><U>BranchId</U>, BranchName,<BR/>Address>];
  CLASS [pos="7,2.1!", label=<<B>CLASS</B><BR/><U>ClassId</U>, ClassName,<BR/>StartDate, MaxStudents,<BR/>Tuition, Status>];
  COURSE [pos="10.5,2.1!", label=<<B>COURSE</B><BR/><U>CourseId</U>, CourseName,<BR/>Level, SessionCount,<BR/>Tuition, SyllabusXml>];
  ROOM [pos="3.5,0!", label=<<B>ROOM</B><BR/><U>RoomId</U>, RoomName,<BR/>Capacity>];
  CLASS_SCHEDULE [pos="7,0!", label=<<B>CLASS_SCHEDULE</B> (yếu)<BR/><U>Weekday</U>, StartTime,<BR/>EndTime>, peripheries=2];
  GRADE_COMPONENT [pos="10.5,0!", label=<<B>GRADE_COMPONENT</B><BR/><U>ComponentId</U>,<BR/>ComponentName, Weight>];

  node [shape=diamond, style=filled, fillcolor="#FEF3C7", color="#B45309", penwidth=1.2, fontsize=10, width=0.95, height=0.62, margin=0];
  r_luong [pos="3.5,5.25!", label="nhận"];
  r_tkGV [pos="1.75,4.2!", label="đăng nhập\n(GV)"];
  r_day [pos="5.25,4.2!", label="dạy"];
  r_tkNV [pos="0,3.15!", label="đăng nhập\n(NV)"];
  r_ql [pos="3.5,3.15!", label="trực\nthuộc"];
  r_pt [pos="5.25,3.15!", label="phụ\ntrách"];
  r_gom2 [pos="7,3.15!", label="gồm\nbuổi"];
  r_gom [pos="10.5,3.15!", label="gồm"];
  r_tuyen [pos="1.75,2.1!", label="làm việc\ntại"];
  r_cn [pos="5.25,2.1!", label="thuộc"];
  r_mo [pos="8.75,2.1!", label="mở\nthành"];
  r_tq [pos="12.1,3.2!", label="tiên\nquyết"];
  r_co [pos="3.5,1.05!", label="có"];
  r_ph [pos="5.25,1.05!", label="học tại"];
  r_lich [pos="7,1.05!", label="học\ntheo"];
  r_dg [pos="10.5,1.05!", label="đánh giá\ntheo"];

  TEACHER -- r_luong [taillabel="(0,n)"]; r_luong -- PAYROLL [headlabel="(1,1)"];
  ACCOUNT -- r_tkGV [taillabel="(0,1)"]; r_tkGV -- TEACHER [headlabel="(0,1)"];
  TEACHER -- r_day [taillabel="(0,n)"]; r_day -- CLASS_SESSION [headlabel="(1,1)"];
  ACCOUNT -- r_tkNV [taillabel="(0,1)"]; r_tkNV -- EMPLOYEE [headlabel="(0,1)"];
  TEACHER -- r_ql [taillabel="(1,1)"]; r_ql -- BRANCH [headlabel="(0,n)"];
  TEACHER -- r_pt [taillabel="(0,n)"]; r_pt -- CLASS [headlabel="(1,1)"];
  CLASS -- r_gom2 [taillabel="(0,n)"]; r_gom2 -- CLASS_SESSION [headlabel="(1,1)"];
  PROGRAM -- r_gom [taillabel="(1,n)"]; r_gom -- COURSE [headlabel="(1,1)"];
  EMPLOYEE -- r_tuyen [taillabel="(1,1)"]; r_tuyen -- BRANCH [headlabel="(1,n)"];
  CLASS -- r_cn [taillabel="(1,1)"]; r_cn -- BRANCH [headlabel="(0,n)"];
  COURSE -- r_mo [taillabel="(0,n)"]; r_mo -- CLASS [headlabel="(1,1)"];
  COURSE -- r_tq [headlabel="(0,1) cần", labelangle=40, labeldistance=2.4]; r_tq -- COURSE [taillabel="(0,n) là", labelangle=-40, labeldistance=2.4];
  BRANCH -- r_co [taillabel="(1,n)"]; r_co -- ROOM [headlabel="(1,1)"];
  CLASS -- r_ph [taillabel="(1,1)"]; r_ph -- ROOM [headlabel="(0,n)"];
  CLASS -- r_lich [taillabel="(1,n)"]; r_lich -- CLASS_SCHEDULE [headlabel="(1,1)"];
  COURSE -- r_dg [taillabel="(1,n)"]; r_dg -- GRADE_COMPONENT [headlabel="(1,1)"];
}
